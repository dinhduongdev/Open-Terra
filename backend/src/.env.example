# =============================================================================
# OPEN-TERRA BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=Open-Terra Backend

# CORS - Allowed origins
CORS_ORIGINS=["*"]

# =============================================================================
# CONTEXT BROKER (FIWARE Orion-LD)
# =============================================================================
CONTEXT_BROKER_URL=http://localhost:1026
CONTEXT_URL=http://context/user-context.jsonld

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_DIALECT=sqlite
DATABASE_NAME=./crudadmin_data/app.db

# =============================================================================
# REDIS (All disabled for development without Redis)
# =============================================================================
USE_REDIS_CACHE=false
USE_REDIS_QUEUE=false
CRUD_ADMIN_REDIS_ENABLED=false
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379

# =============================================================================
# EXTERNAL APIs (Optional - Leave empty if not using)
# =============================================================================

# OpenAQ - Air Quality Data
OPEN_AQ_API_KEY=

# OpenWeatherMap - Weather Data  
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHERMAP_API_KEY=

# TomTom - Maps & Routing
TOMTOM_API_KEY=

# =============================================================================
# CRUD ADMIN
# =============================================================================
CRUD_ADMIN_ENABLED=true
CRUD_ADMIN_MOUNT_PATH=/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Service Tier
TIER_NAME=free

# Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# === GOOGLE GEMINI ===
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash