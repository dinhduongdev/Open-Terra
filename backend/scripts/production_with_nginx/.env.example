# ============================================================================
# WARNING: EXAMPLE CONFIGURATION - DO NOT USE IN PRODUCTION AS-IS
# ============================================================================
# This file contains example values for development/testing purposes only.
#
# SECURITY CRITICAL: Before deploying to production, you MUST:
#   1. Copy this file to src/.env
#   2. Generate a new SECRET_KEY using: openssl rand -hex 32
#   3. Change all passwords (POSTGRES_PASSWORD, ADMIN_PASSWORD, etc.)
#   4. Update all sensitive configuration values
#
# Using these example values in production is a SECURITY RISK.
# ============================================================================

# ------------- app settings -------------
APP_NAME="Open Terra"
APP_DESCRIPTION="Open Terra Backend API"
APP_VERSION="0.1"
CONTACT_NAME="Open Terra Team"
CONTACT_EMAIL="open@openterra.com"
LICENSE_NAME="MIT"

# ------------- database ------------- 
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_SERVER="open-terra-backend-db"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"

# ------------- crypt -------------
SECRET_KEY="change_me_generate_with_openssl_rand_hex_32"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------- admin -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_in_production"

# ------------- redis cache -------------
REDIS_CACHE_HOST="open-terra-backend-redis"
REDIS_CACHE_PORT=6379

# ------------- redis queue -------------
REDIS_QUEUE_HOST="open-terra-backend-redis"
REDIS_QUEUE_PORT=6379

# ------------- redis rate limit -------------
REDIS_RATE_LIMIT_HOST="open-terra-backend-redis"
REDIS_RATE_LIMIT_PORT=6379

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

# ------------- CORS -------------
CORS_ORIGINS=["https://open-terra.io.vn"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ------------- test -------------
TEST_NAME="Tester User"
TEST_EMAIL="test@tester.com"
TEST_USERNAME="testeruser"
TEST_PASSWORD="Str1ngT3st!"

# ------------- environment -------------
ENVIRONMENT="production"

# ------------- first tier -------------
TIER_NAME="free"

# ------------- external APIs -------------
OPENWEATHERMAP_BASE_URL="https://api.openweathermap.org/data/3.0/onecall"
OPENWEATHERMAP_API_KEY="your_openweathermap_api_key_here"

# TomTom API (optional - for traffic data)
TOMTOM_API_KEY="your_tomtom_api_key_here"

# OpenAQ API (optional - for air quality data)
OPEN_AQ_BASE_URL="https://api.openaq.org/v3"
OPEN_AQ_API_KEY="your_openaq_api_key_here"

# -------------Location for weather data -------------
WEATHER_LOCATIONS="hcm:Ho Chi Minh City:10.8231:106.6297"
