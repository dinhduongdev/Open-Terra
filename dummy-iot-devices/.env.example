# ============================================================================
# MQTT Broker Configuration
# ============================================================================
# URL of the MQTT broker (Mosquitto)
# For Docker: use service name, e.g., mqtt://mosquitto:1883
# For local: use mqtt://localhost:1883
MQTT_BROKER_URL=mqtt://mosquitto:1883

# ============================================================================
# IoT Agent Configuration
# ============================================================================
# URL of the FIWARE IoT Agent for UltraLight 2.0
# For Docker: use service name, e.g., http://iot-agent:4041
# For local: use http://localhost:4041
IOTA_URL=http://iot-agent:4041

# ============================================================================
# FIWARE Service Headers
# ============================================================================
# FIWARE service name (tenant)
FIWARE_SERVICE=openiot

# FIWARE service path (sub-tenant)
FIWARE_SERVICEPATH=/

# API Key for UltraLight 2.0 protocol
# This should match the API key configured in IoT Agent
API_KEY=4jggokgpepnvsb2uv4s40d59ov

# ============================================================================
# Traffic Flow Observed Devices Configuration
# ============================================================================
# Update interval for traffic devices (in milliseconds)
TRAFFIC_INTERVAL=30000

# Traffic Device 1
TRAFFIC_DEVICE_ID_1=traffic001
TRAFFIC_ENTITY_NAME_1=urn:ngsi-ld:TrafficFlowObserved:001

# Traffic Device 2
TRAFFIC_DEVICE_ID_2=traffic002
TRAFFIC_ENTITY_NAME_2=urn:ngsi-ld:TrafficFlowObserved:002

# Traffic Device 3
TRAFFIC_DEVICE_ID_3=traffic003
TRAFFIC_ENTITY_NAME_3=urn:ngsi-ld:TrafficFlowObserved:003

# ============================================================================
# Water Quality Observed Devices Configuration
# ============================================================================
# Update interval for water quality devices (in milliseconds)
WATER_INTERVAL=30000

# Water Device 1
WATER_DEVICE_ID_1=water001
WATER_ENTITY_NAME_1=urn:ngsi-ld:WaterObserved:001

# Water Device 2
WATER_DEVICE_ID_2=water002
WATER_ENTITY_NAME_2=urn:ngsi-ld:WaterObserved:002

# Water Device 3
WATER_DEVICE_ID_3=water003
WATER_ENTITY_NAME_3=urn:ngsi-ld:WaterObserved:003
