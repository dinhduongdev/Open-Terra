    }
    
    location / {
        return 200 "OK - Waiting for SSL setup";
        add_header Content-Type text/plain;
    }
}

# ==============================================================================
# Open Data Server (Orion Context Broker) - opendata.open-terra.io.vn
# ==============================================================================
server {
    listen 80;
    server_name opendata.open-terra.io.vn;
    
    location /.well-known/acme-challenge/ {
